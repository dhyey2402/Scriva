DJANGO_SECRET_KEY=your-production-django-secret-key-here
SECRET_KEY=your-production-django-secret-key-here
DEBUG=False
DATABASE_URL=postgresql://user:password@host:port/dbname
ALLOWED_HOSTS=localhost,127.0.0.1,scriva.onrender.com,.onrender.com

# Comma-separated list of allowed frontend origins (e.g. Vercel deployment URLs and localhost)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,https://scriva.onrender.com,https://your-portfolio.vercel.app,https://your-cms.vercel.app
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:5174,https://scriva.onrender.com,https://your-portfolio.vercel.app,https://your-cms.vercel.app

# Email Configuration
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=user@example.com
EMAIL_HOST_PASSWORD=your-email-password-here
DEFAULT_FROM_EMAIL=webmaster@yourdomain.com
CONTACT_EMAIL=admin@yourdomain.com
